<h1>スコア詳細</h1>

<h2><%= @restaurant.name %></h2>

<p>
  <%= @restaurant.group_genre.genre %> /
  <%= @restaurant.budget %>円
</p>

<p>
  <%= @restaurant.group_area.area %>
</p>

<p>
  合計スコア：
  <%= @total_score %>点
</p>

<h2>このお店が上位になった理由</h2>

<p>
  ✓ <%= @budget_reason %>
</p>

<p>
  ✓ <%= @genre_reason %>
</p>

<p>
  ✓ <%= @area_reason %>
</p>

<% if @avoid_reason %>
  <p>
    ✓ 全員の避けたい条件に該当しない
  </p>
<% end %>

<h2>メンバーごとの一致度</h2>

<% @group.group_members.each_with_index do |group_member, index| %>
  <p>
    <%= group_member.nickname %>：
    <%= @member_scores[group_member.id] %>点
  </p>

  <% if group_member.participant_condition %>
    <p>
      予算：〜<%= number_with_delimiter(group_member.participant_condition.budget) %>円
    </p>

    <p>
      ジャンル：<%= group_member.participant_condition.group_genres.map(&:genre).join("、") %>
    </p>

    <p>
      エリア：<%= group_member.participant_condition.group_areas.map(&:area).join("、") %>
    </p>

    <p>
      避けたい条件：<%= group_member.participant_condition.participant_condition_avoids.any? ? group_member.participant_condition.participant_condition_avoids.map { |avoid| avoid.group_avoid_condition.condition }.join("、") : "該当なし" %>
    </p>
  <% end %>

  <% unless index == @group.group_members.length - 1 %>
    <hr>
  <% end %>
<% end %>

<%= link_to "ランキングに戻る",
            group_ranking_path(
              @group,
              group_member_id: @group_member.id
            ) %>

<%= link_to "グループ一覧", groups_path %>
