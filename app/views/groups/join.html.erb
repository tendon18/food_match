<h1><%= @group.name %></h1>

<% if flash[:alert] %>
  <p style="color: red;">
    <%= flash[:alert] %>
  </p>
<% end %>

<p>
  このグループに参加します。
</p>

<p>
  みんなでお店を決めよう！
</p>

<%= form_with url: join_group_create_path(@group.invite_token), method: :post, local: true do |f| %>
  <div>
    <%= f.label :nickname, "ニックネーム" %>
    <br>
    <%= f.text_field :nickname %>
    <br><br>
  </div>

   <div class="terms">
    <p>
      グループの利用を開始する前に、
      <%= link_to "利用規約", pages_terms_path, class: "link" %>
      <%= link_to "プライバシーポリシー", pages_privacy_policy_path, class: "link" %>
      をご確認ください。
    </p>
  </div>

  <p>
    <%= f.submit "グループに参加する", class: "button" %>
  </p>
<% end %>
