<h1>登録が完了しました！</h1>

<p>早速、グループを作成してみましょう。</p>

<%= form_with model: @group do |f| %>
  <div>
    <p>まずはグループ名を入力してください</p>
    <%= f.text_field :name %>
  </div>

  <div>
    <p>あなたのニックネームを入力してください</p>
    <%= text_field_tag :nickname %>
    <p>※このニックネームは、今後グループの参加者のみんなに表示されます。</p>
  </div>

  <%= f.submit "グループを作成する" %>
<% end %>
