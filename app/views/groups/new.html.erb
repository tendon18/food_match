<% if @from_signup %>
  <h1>登録が完了しました！</h1>

  <p>早速、グループを作成してみましょう</p>
<% else %>
  <h1>新しいグループを作成する</h1>
<% end %>

<%= form_with model: @group do |f| %>
  <div>
    <p>まずはグループ名を入力してください</p>
    <%= f.text_field :name %>
  </div>

  <div>
    <p>あなたのニックネームを入力してください</p>
    <%= text_field_tag :nickname %>
    <p>※このニックネームは、今後グループの参加者のみんなに表示されます。</p>
  </div>

  <%= f.submit "グループを作成する", class: "button" %>
<% end %>

<% unless @from_signup %>
  <%= link_to "グループ一覧へ", groups_path %>
<% end %>
