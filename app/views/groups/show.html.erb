<h1><%= @group.name %></h1>

<p>グループページ</p>

<h2>参加メンバー</h2>

<% @group_members.each do |group_member| %>
  <p>
    <%= group_member.nickname %>
    <% if group_member.organizer? %>
      （幹事）
    <% end %>
  </p>
<% end %>

<% if @group_member.organizer? %>
  <h2>共有URL</h2>

  <p>
    <%= request.base_url + "/groups/join/#{@group.invite_token}" %>
  </p>
<% end %>

<% if @group.decided_restaurant_id %>
  <% decided_restaurant = @group.restaurants.find(@group.decided_restaurant_id) %>

  <h2>決定した店舗</h2>

  <h3><%= decided_restaurant.name %></h3>

  <p>
    <%= decided_restaurant.group_genre.genre %>
    /
    <%= number_with_delimiter(decided_restaurant.budget) %>円
  </p>

  <p>
    <%= decided_restaurant.group_area.area %>
  </p>

  <%= link_to "決定した店舗を見る",
              group_decision_complete_path(
                @group,
                group_member_id: @group_member.id
              ) %>
<% end %>

<%= link_to "候補店舗一覧を見る",
            group_restaurants_index_path(
              @group,
              group_member_id: @group_member.id
            ) %>

<%= link_to "ランキングを見る",
            group_ranking_path(
              @group,
              group_member_id: @group_member.id
            ) %>

<% if @group_member.organizer? %>
  <%= link_to "グループ一覧へ", groups_path %>
<% end %>
