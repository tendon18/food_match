<h1>グループ一覧</h1>

<% if @groups.any? %>
  <% @groups.each do |group| %>
    <div>
      <%= link_to group.name, group_path(group) %>
    </div>
  <% end %>
<% else %>
  <p>グループがありません</p>
<% end %>

<p>
  <div style="margin-bottom: 12px;">
    <%= link_to "グループを作成する",
                new_group_path,
                class: "button" %>
  </div>
</p>

<div>
  <%= button_to "ログアウト",
                session_path,
                method: :delete,
                class: "button-danger" %>
</div>
