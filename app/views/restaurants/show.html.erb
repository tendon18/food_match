<h1>候補店舗の詳細</h1>

<h2><%= @restaurant.name %></h2>

<p>
  予算：
  <%= @restaurant.budget %>円
</p>

<p>
  ジャンル：
  <%= @restaurant.group_genre.genre %>
</p>

<p>
  エリア：
  <%= @restaurant.group_area.area %>
</p>

<p>
  特徴：
  <%= @restaurant.features %>
</p>

<p>
  店舗URL：
  <% if @restaurant.url.present? %>
    <%= link_to @restaurant.url, @restaurant.url, target: "_blank", rel: "noopener" %>
  <% end %>
</p>

<p>
  メモ：
  <%= @restaurant.memo %>
</p>

<p>
  追加者：
  <%= @restaurant.added_by.nickname %>
</p>

<h3>店舗のNG条件</h3>

<% @restaurant.restaurant_avoid_conditions.each do |restaurant_avoid_condition| %>
  <p>
    <%= restaurant_avoid_condition.group_avoid_condition.condition %>：
    <% if restaurant_avoid_condition.status == "applicable" %>
      該当する
    <% elsif restaurant_avoid_condition.status == "not_applicable" %>
      該当しない
    <% else %>
      情報なし・判定できない
    <% end %>
  </p>
<% end %>

<p>
  <%= link_to "店舗のNG条件を編集する",
              edit_restaurant_avoid_condition_path(
                @group,
                @restaurant,
                group_member_id: @group_member.id
              ) %>
</p>

<p>
  <%= link_to "候補店舗一覧に戻る",
              group_restaurants_index_path(
                @group,
                group_member_id: @group_member.id
              ) %>
</p>

<% if @restaurant.added_by == @group_member %>
  <p>
    <%= link_to "候補店舗を編集する",
                edit_restaurant_path(
                  @group,
                  @restaurant,
                  group_member_id: @group_member.id
                ) %>
  </p>

  <p>
    <%= link_to "候補店舗を削除する",
                destroy_restaurant_path(
                  @group,
                  @restaurant,
                  group_member_id: @group_member.id
                ),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "この候補店舗を削除しますか？"
                } %>
  </p>
<% end %>

<p>
  <%= link_to "グループ一覧へ", groups_path %>
</p>
