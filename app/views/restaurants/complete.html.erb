<h1>候補店舗を追加しました</h1>

<p>
  「<%= @restaurant.name %>」を候補店舗に追加しました。
</p>

<p>
  みんなで行きたいお店候補に追加しました！
</p>

<div>
  <%= link_to "候補店舗を追加する",
              new_restaurant_path(
                @group,
                group_member_id: params[:group_member_id]
              ) %>
</div>

<div>
  <%= link_to "店舗のNG条件を登録する",
              new_restaurant_avoid_condition_path(
                @group,
                @restaurant,
                group_member_id: params[:group_member_id]
              ) %>
</div>

<div>
  <%= form_with url: complete_restaurant_submission_path(@group),
                method: :patch,
                local: true do %>
    <%= hidden_field_tag :group_member_id, params[:group_member_id] %>
    <%= submit_tag "候補店舗の追加を完了する" %>
  <% end %>
</div>

<div>
  <%= link_to "候補店舗一覧を見る",
              group_restaurants_index_path(
                @group,
                group_member_id: params[:group_member_id]
              ) %>
</div>

<% if @group_member.organizer? %>
  <div>
    <%= link_to "グループ一覧へ", groups_path %>
  </div>
<% end %>
