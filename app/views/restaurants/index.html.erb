<h1>みんなが追加した店舗一覧</h1>

<% @restaurants.each do |restaurant| %>
  <div>
    <h2>
      <%= link_to restaurant.name, restaurant_path(@group, restaurant) %>
    </h2>

    <p>
      予算：
      <%= restaurant.budget %>円
    </p>

    <p>
      ジャンル：
      <%= restaurant.group_genre.genre %>
    </p>

    <p>
      エリア：
      <%= restaurant.group_area.area %>
    </p>

    <p>
      追加した人：
      <%= restaurant.added_by.nickname %>
    </p>
  </div>

  <hr>
<% end %>
