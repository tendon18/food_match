<h1>みんなが追加した店舗一覧</h1>

<h2>参加状況</h2>

<% completed_count = @group_members.count(&:restaurant_submission_completed) %>

<% if completed_count == @group_members.count %>
  <p>
    <%= @group_members.count %>人全員が候補を追加しました！
  </p>
<% else %>
  <p>
    <%= completed_count %> / <%= @group_members.count %>人が候補を追加しています
  </p>
<% end %>

<% @group_members.each do |group_member| %>
  <div>
    <% if group_member.restaurant_submission_completed %>
      ✓
      <%= group_member.nickname %>　回答済み
    <% else %>
      ○
      <%= group_member.nickname %>　未回答
    <% end %>
  </div>
<% end %>

<% if @restaurants.empty? %>
  <p>候補店舗はまだありません</p>
<% else %>
  <% @restaurants.each do |restaurant| %>
    <div>
      <h2>
        <%= link_to restaurant.name,
                    restaurant_path(
                      @group,
                      restaurant,
                      group_member_id: params[:group_member_id]
                    ) %>
      </h2>

      <p>
        ジャンル：
        <%= restaurant.group_genre.genre %>
      </p>

      <p>
        エリア：
        <%= restaurant.group_area.area %>
      </p>

      <p>
        予算：
        <%= restaurant.budget %>円
      </p>

      <p>
        追加した人：
        <%= restaurant.added_by.nickname %>
      </p>
    </div>

    <hr>
  <% end %>
<% end %>

<%= link_to "候補店舗を追加する",
            new_restaurant_path(
              @group,
              group_member_id: @group_member.id
            ) %>

<%= link_to "ランキングを見る",
            group_ranking_path(
              @group,
              group_member_id: @group_member.id
            ) %>

<% if @group_member.organizer? %>
  <%= link_to "グループ一覧へ", groups_path %>
<% end %>
