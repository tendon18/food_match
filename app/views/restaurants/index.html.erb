<h1>みんなが追加した店舗一覧</h1>

<% if @restaurants.empty? %>
  <p>候補店舗はまだありません</p>
<% else %>
  <% @restaurants.each_with_index do |restaurant, index| %>
    <div>
      <p>
        第<%= index + 1 %>位
      </p>

      <h2>
        <%= link_to restaurant.name,
                    restaurant_path(
                      @group,
                      restaurant,
                      group_member_id: params[:group_member_id]
                    ) %>
      </h2>
    
      <p>
        ジャンル：
        <%= restaurant.group_genre.genre %>
      </p>

      <p>
        エリア：
        <%= restaurant.group_area.area %>
      </p>

      <p>
        予算：
        <%= restaurant.budget %>円
      </p>

      <p>
        追加した人：
        <%= restaurant.added_by.nickname %>
      </p>

    <% if @group_member.organizer? %>
      <p>
        合計スコア：
        <%= @total_scores[restaurant.id] %>点
      </p>
    <% end %>
    </div>

    <hr>
  <% end %>
<% end %>

<%= link_to "候補店舗を追加する",
            new_restaurant_path(
              @group,
              group_member_id: @group_member.id
            ) %>

<% if @group_member.organizer? %>
  <%= link_to "グループ一覧へ", groups_path %>
<% end %>
