<h1>ログイン</h1>

<%= form_with url: session_path, local: true, data: { turbo: false } do |f| %>

  <div>
    <%= f.label :email, "メールアドレス" %>
    <%= f.text_field :email %>
  </div>

  <div>
    <%= f.label :password, "パスワード" %>
    <%= f.password_field :password %>
  </div>

<%= f.submit "ログインする" %>
<% end %>

<%= link_to "パスワードをお忘れの方はこちら", new_password_reset_path %>
