<h1>グループ作成 Step 3</h1>

<p>1人あたりの予算はどのくらいですか？</p>

<%= form_with url: save_group_conditions_budget_path(@group),
              method: :post,
              local: true do |f| %>

  <div>
    <%= f.label :budget, "予算" %>
    <%= f.select :budget,
        [
          ["1,000円以下", 1000],
          ["2,000円以下", 2000],
          ["3,000円以下", 3000],
          ["4,000円以下", 4000],
          ["5,000円以下", 5000],
          ["6,000円以下", 6000],
          ["7,000円以下", 7000],
          ["8,000円以下", 8000],
          ["9,000円以下", 9000],
          ["10,000円以下", 10000]
        ],
        { include_blank: "予算を選択してください" } %>
  </div>

  <%= f.submit "次へ進む" %>
<% end %>
