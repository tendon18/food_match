<h1>グループ作成 Step 3</h1>

<p>1人あたりの予算はどのくらいですか？</p>

<%= form_with url: save_group_conditions_budget_path(@group),
              method: :post,
              local: true do |f| %>

  <div>
    <%= f.label :budget, "予算" %>
    <%= f.select :budget,
        [
          ["〜2,000円", 2000],
          ["〜3,000円", 3000],
          ["〜4,000円", 4000],
          ["〜5,000円", 5000],
          ["6,000円以上", 6000]
        ],
        { include_blank: "予算を選択してください" } %>
  </div>

  <%= f.submit "次へ進む" %>
<% end %>
